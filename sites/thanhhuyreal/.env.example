# ============ THANHHUYREAL - PHP login có CSRF ============
# Copy file này thành .env rồi điền giá trị.
# .env đã được gitignore — KHÔNG commit credentials.

PHP_BASE_URL=https://thanhhuyreal.com
PHP_LOGIN_PAGE=/?auth=login
PHP_LOGIN_PATH=/model/login

# ---------- Account ----------
# NÊN là account user riêng cho test, KHÔNG dùng admin.
# Mỗi lần login thành công sẽ tạo 1 session mới.
PHP_IDENTIFIER=
PHP_PASSWORD=

# true = mỗi lần login dùng session mới (GET trang + POST = 2 request)
# false = dùng lại session của VU (chỉ đo POST)
PHP_FRESH_SESSION=true

# ---------- Tải (leo theo req/s) ----------
# "<giây giữ>:<rps>" phân cách bằng dấu phẩy.
STAGES=30s:100,60s:300,60s:600,15s:0
START_RATE=50

PRE_VUS=100
MAX_VUS=800

REQUEST_DELAY=0
REQUEST_TIMEOUT=15s

# ---------- Ngưỡng ----------
MAX_5XX_RATE=0.02
MAX_TIMEOUT_RATE=0.05
ABORT_ON_BAN=false
