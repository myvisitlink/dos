# ================= NESTINVEST - POST /auth/login =================
# Copy file này thành .env rồi điền giá trị.
# .env đã được gitignore — KHÔNG commit credentials.

BASE_URL=https://mice.3nestinvest.com/api/v1

# ---------- Tải (leo theo req/s) ----------
# "<giây giữ>:<rps>" phân cách bằng dấu phẩy.
STAGES=30s:500,60s:1500,60s:3000,60s:3000,15s:0
START_RATE=100

# VU cấp sẵn / tối đa. k6 tự tạo thêm nếu không đủ.
PRE_VUS=300
MAX_VUS=2000

REQUEST_DELAY=0
REQUEST_TIMEOUT=10s

# ---------- Ngưỡng ----------
MAX_5XX_RATE=0.02
MAX_TIMEOUT_RATE=0.05

# Tự dừng ngay khi bị 403/429
ABORT_ON_BAN=false

# ---------- Spoof header (A/B) ----------
# Chỉ có tác dụng nếu server TIN header. Không tin => y hệt khi tắt.
SPOOF_HEADERS=false
SPOOF_STRATEGY=all

# ---------- Account ----------
# Để trống cả 2 => email random + sai mật khẩu (không cần account).
TEST_EMAIL=
TEST_PASSWORD=

EMAIL_DOMAIN=loadtest.example.com
WRONG_PASSWORD=WrongPass123!
