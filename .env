# File cấu hình biến môi trường cho k6
# Thay đổi URL web của bạn tại đây:
TARGET_URL=https://caffemmo.com/api/notifications

# Phương thức HTTP: GET hoặc POST
HTTP_METHOD=GET

# Số lượng Virtual Users (VUs) mỗi container:
VUS=200

# Thời gian duy trì tải (vd: 30s, 1m, 5m):
DURATION=30m

# Thời gian nghỉ giữa các request của mỗi VU (giây, vd: 0.05 = 20 req/s/VU):
REQUEST_DELAY=0.02
